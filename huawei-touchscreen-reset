#!/bin/sh
set -eu

touch_device="/sys/bus/i2c/devices/i2c-FTSC1000:00"
pci_controller="0000:00:15.1"
pci_device="/sys/bus/pci/devices/$pci_controller"
pci_driver="/sys/bus/pci/drivers/intel-lpss"
pci_controller_power="$pci_device/power/control"
bus_controller_power="/sys/bus/platform/devices/i2c_designware.1/power/control"
lock_file="/run/lock/huawei-touchscreen-reset.lock"

# Never reset concurrently
exec 9>"$lock_file"
flock -w 30 9 || exit 0

keep_controllers_awake() {
    if [ -w "$pci_controller_power" ]; then
        printf "on" > "$pci_controller_power" 2>/dev/null || true
    fi
    if [ -w "$bus_controller_power" ]; then
        printf "on" > "$bus_controller_power" 2>/dev/null || true
    fi
}

is_touchscreen_healthy() {
    bind_start="${1:-0}"

    [ -d "$touch_device" ] || return 1
    [ -L "$touch_device/driver" ] || return 1

    # Verify HID device is bound to hid-multitouch (not hid-generic fallback)
    found_multitouch=0
    for dev in "$touch_device"/0018:2808:5662.*; do
        [ -d "$dev" ] || continue
        if [ -L "$dev/driver" ]; then
            driver_name=$(basename "$(readlink -f "$dev/driver" 2>/dev/null || true)")
            if [ "$driver_name" = "hid-multitouch" ]; then
                found_multitouch=1
                break
            fi
        fi
    done
    [ "$found_multitouch" -eq 1 ] || return 1

    # Verify input device and char event node exist and can be accessed
    found_node=0
    for dev in "$touch_device"/0018:2808:5662.*; do
        [ -d "$dev" ] || continue
        for inp in "$dev"/input/input*; do
            [ -d "$inp" ] || continue
            for ev in "$inp"/event*; do
                [ -e "$ev" ] || continue
                ev_name=$(basename "$ev")
                if [ -c "/dev/input/$ev_name" ]; then
                    found_node=1
                    break 3
                fi
            done
        done
    done
    [ "$found_node" -eq 1 ] || return 1

    # Verify no corrupted report descriptor or fatal bus errors occurred during this bind
    if [ "$bind_start" != "0" ]; then
        if dmesg 2>/dev/null | awk -v start="$bind_start" '
            match($0, /^\[ *([0-9]+\.[0-9]+)\]/, m) {
                t = m[1] + 0;
                if (t >= start) {
                    if ($0 ~ /(lost arbitration|failed to get a report from device: -(5|121)|failed to fetch feature 5|failed to fetch HID descriptor|failed to reset device)/) {
                        if ($0 ~ /(FTSC1000|i2c_designware\.1|2808:5662)/) {
                            found = 1;
                        }
                    }
                }
            }
            END { exit (found ? 1 : 0) }
        '; then
            : # Clean
        else
            echo "Corrupt HID report descriptor or communication error detected in dmesg; probe failed." >&2
            return 1
        fi
    fi

    return 0
}

reset_intel_lpss() {
    echo "Rebinding dedicated Intel LPSS I2C controller $pci_controller..."
    keep_controllers_awake
    bind_start=$(awk '{print $1}' /proc/uptime 2>/dev/null || echo "0")

    if [ -L "$pci_device/driver" ]; then
        current_driver=$(readlink -f "$pci_device/driver" 2>/dev/null || true)
        if [ "$current_driver" = "$pci_driver" ]; then
            printf "%s" "$pci_controller" > "$pci_driver/unbind" 2>/dev/null || true
        fi
    fi

    sleep 2

    if ! printf "%s" "$pci_controller" > "$pci_driver/bind" 2>/dev/null; then
        echo "Failed to bind to $pci_driver" >&2
        return 1
    fi

    udevadm settle --timeout=5 2>/dev/null || true
    keep_controllers_awake

    attempt=1
    while [ "$attempt" -le 8 ]; do
        if is_touchscreen_healthy "$bind_start"; then
            echo "Touchscreen input device initialized successfully via Intel LPSS rebind."
            return 0
        fi
        sleep 0.5
        attempt=$((attempt + 1))
    done

    echo "Touchscreen input device did not initialize properly via Intel LPSS rebind." >&2
    return 1
}

reset_pci_rescan() {
    echo "Power cycling and rescanning PCI device $pci_controller..."
    keep_controllers_awake
    bind_start=$(awk '{print $1}' /proc/uptime 2>/dev/null || echo "0")

    echo "i2c-FTSC1000:00" > /sys/bus/i2c/drivers/i2c_hid_acpi/unbind 2>/dev/null || true
    echo "i2c_designware.1" > /sys/bus/platform/drivers/i2c_designware/unbind 2>/dev/null || true
    if [ -w "$pci_device/remove" ]; then
        echo 1 > "$pci_device/remove" 2>/dev/null || true
    fi
    sleep 1
    echo 1 > /sys/bus/pci/rescan 2>/dev/null || true
    sleep 2
    keep_controllers_awake

    attempt=1
    while [ "$attempt" -le 8 ]; do
        if is_touchscreen_healthy "$bind_start"; then
            echo "Touchscreen input device initialized successfully via PCI rescan."
            return 0
        fi
        sleep 0.5
        attempt=$((attempt + 1))
    done

    echo "Touchscreen input device did not initialize properly via PCI rescan." >&2
    return 1
}

reload_modules() {
    echo "Reloading I2C HID modules as fallback..."
    keep_controllers_awake
    bind_start=$(awk '{print $1}' /proc/uptime 2>/dev/null || echo "0")

    modprobe -r hid_multitouch 2>/dev/null || true
    modprobe -r i2c_hid_acpi 2>/dev/null || true
    sleep 2
    modprobe i2c_hid_acpi
    modprobe hid_multitouch
    udevadm settle --timeout=5 2>/dev/null || true
    keep_controllers_awake

    attempt=1
    while [ "$attempt" -le 8 ]; do
        if is_touchscreen_healthy "$bind_start"; then
            echo "Touchscreen input device initialized successfully via module reload."
            return 0
        fi
        sleep 0.5
        attempt=$((attempt + 1))
    done

    echo "Touchscreen input device did not initialize properly via module reload." >&2
    return 1
}

echo "Waiting 2s for hardware and display power to settle..."
sleep 2
keep_controllers_awake

# Attempt 1: Rebind Intel LPSS controller
echo "Touchscreen reset attempt 1 (Intel LPSS rebind)..."
if reset_intel_lpss; then
    exit 0
fi

# Attempt 2: Rebind Intel LPSS controller again with slightly longer settle
sleep 1
echo "Touchscreen reset attempt 2 (Intel LPSS rebind retry)..."
if reset_intel_lpss; then
    exit 0
fi

# Attempt 3: PCI remove and rescan
sleep 1
echo "Touchscreen reset attempt 3 (PCI hardware rescan)..."
if reset_pci_rescan; then
    exit 0
fi

# Attempt 4: Module reload fallback
sleep 1
echo "Touchscreen reset attempt 4 (Kernel module reload fallback)..."
if reload_modules; then
    exit 0
fi

echo "Touchscreen reset failed after all attempts." >&2
exit 1
