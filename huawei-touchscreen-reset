#!/bin/sh
set -eu

hid_module="i2c_hid_acpi"
touch_device="/sys/bus/i2c/devices/i2c-FTSC1000:00"
controller_power="/sys/bus/pci/devices/0000:00:15.1/power/control"
lock_file="/run/lock/huawei-touchscreen-reset.lock"

# Boot and resume hooks can overlap.  Never reset the shared I2C-HID stack twice.
exec 9>"$lock_file"
flock -n 9 || exit 0

is_touchscreen_present() {
    [ -d "$touch_device" ] || return 1
    [ -L "$touch_device/driver" ] || return 1

    for inp in "$touch_device"/0018:2808:5662.*/input/input*; do
        [ -d "$inp" ] && return 0
    done

    return 1
}

reload_i2c_hid() {
    echo "Reloading $hid_module for the FTSC1000 touchscreen..."

    # Runtime-suspending this controller leaves the digitizer enumerated but
    # unable to deliver reports on this Huawei firmware.  Keep this controller
    # awake; the neighboring touchpad controller remains power-managed.
    if [ -w "$controller_power" ]; then
        printf "on" > "$controller_power"
    fi

    # The FTSC1000 controller can remain electrically wedged after a failed
    # probe.  Rebinding only intel-lpss recreates the input node but does not
    # reset the HID handshake.  Reloading the ACPI I2C-HID driver does.
    modprobe -r "$hid_module"
    sleep 2
    modprobe "$hid_module"
    udevadm settle --timeout=5 2>/dev/null || true

    attempt=1
    while [ "$attempt" -le 10 ]; do
        if is_touchscreen_present; then
            echo "Touchscreen input device initialized."
            return 0
        fi
        sleep 1
        attempt=$((attempt + 1))
    done

    echo "Touchscreen input device did not reappear." >&2
    return 1
}

max_retries=3
attempt=1

while [ "$attempt" -le "$max_retries" ]; do
    echo "Touchscreen reset attempt $attempt of $max_retries..."
    if reload_i2c_hid; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 2
done

echo "Touchscreen reset failed after $max_retries attempts." >&2
exit 1
