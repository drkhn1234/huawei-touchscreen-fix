[Unit]
Description=Reset Huawei MateBook 14 touchscreen I2C controller
After=display-manager.service graphical.target
Wants=display-manager.service
ConditionPathExists=/sys/bus/pci/devices/0000:00:15.1

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/huawei-touchscreen-reset
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
